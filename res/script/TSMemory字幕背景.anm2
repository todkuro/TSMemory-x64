--information:TSMemory 字幕背景
--track@padx:横余白,0,200,8,1
--track@pady:縦余白,0,200,4,1
--track@alpha:不透明度,0,100,50,1
--color@bgcol:背景色,0x000000
--check@leftalign:左端で合わせる,1
--check@topalign:上端で合わせる,0
--check@dbg:デバッグ表示,0
--[[
	TSMemory の字幕に、放送と同じ「半透明の黒い箱」を敷き、
	**行の左端を揃える**。

	■ 左端で合わせる

	AviUtl2 のテキストオブジェクトは X が「行の中央」を指す
	(実測で確認)。放送の字幕は左揃えなので、放送側の中央を指定すると
	**書体の幅の違いだけ左端がずれる**。行ごとに文字数が違うので、
	行の左端が揃わずガタガタになる。

	描画後の幅 obj.w はここでしか判らないので、
	オブジェクトを右へ obj.w / 2 ずらして「X = 行の左端」にする。
	プラグイン側はそのつもりで X に放送の左端を入れて来る。

	■ 背景の箱

	**テキストの後ろに図形オブジェクトを置く方式にしていない理由。**
	図形オブジェクトだと寸法が作った時点で固定されるので、
	後からフォントや文字サイズを変えると箱がずれる。
	このスクリプトは描画後の obj.w / obj.h を見るので、
	書体・サイズ・文言を変えても箱が付いて来る。

	**箱は obj.clearbuffer() で作る。obj.load("figure") は使わない。**
	図形の名前が本当に「四角形」で通っているかを確かめる術が無く、
	実機で楕円のような輪郭が出ていた。clearbuffer なら
	「指定の大きさを単色で塗り潰したバッファ」がそのまま得られる。
	伸ばす必要も無いので縦横比の指定も要らない。

	**フレームバッファに直接 obj.draw() してはいけない。**
	「obj.draw() を使用した場合スクリプト以降のフィルタ効果は
	実行されません」(lua.txt) ので、後ろにある標準描画が飛ばされ、
	オブジェクトの X/Y も拡大率も効かなくなる。
	仮想バッファの中で合成してオブジェクトに書き戻し、
	描画そのものは本体に任せる。

	**デバッグ表示は print()。**obj.mes() はログではなく
	「テキストオブジェクトのテキストに文字を挿入する」関数なので、
	ここで呼んでも何も出ない。

	放送の背景は文字セル (36 ドット角 + 字間 4 / 行間 24) の大きさで、
	字形より一回り大きい。余白の既定値はそこから決めている。

	不透明度の既定 50 は ARIB の色表の索引 65 = (0,0,0,α128) に合わせた値。
]]

--	**先に取っておく事。**合成の後は余白のぶん大きくなるので、
--	位置合わせに使うのは文字の幅
local w = obj.w
local h = obj.h

if dbg == 1 then
	print("TSMemory字幕背景: text=" .. w .. "x" .. h
		  .. " padx=" .. padx .. " pady=" .. pady
		  .. " alpha=" .. alpha
		  .. " bgcol=" .. string.format("%06x", bgcol)
		  .. " leftalign=" .. leftalign)
end

if w > 0 and h > 0 and alpha > 0 then
	local bw = w + padx * 2
	local bh = h + pady * 2
	local text = "cache:tsmemory_caption_text"
	local box  = "cache:tsmemory_caption_box"

	obj.copybuffer(text, "object")
	--	箱を「その大きさの単色バッファ」として直接作る
	obj.clearbuffer(box, bw, bh, bgcol)

	--	仮想バッファの中で「背景 + テキスト」を組み立てる。
	--	仮想バッファへの描画はオブジェクトの座標を反映せず、
	--	引数の座標そのままで描かれる (中心が 0,0)
	obj.setoption("drawtarget", "tempbuffer", bw, bh)

	obj.copybuffer("object", box)
	obj.draw(0, 0, 0, 1.0, alpha / 100)

	obj.copybuffer("object", text)
	obj.draw(0, 0, 0, 1.0, 1.0)

	obj.setoption("drawtarget", "framebuffer")
	obj.copybuffer("object", "tempbuffer")

	--	**余白のぶん縦にずらし戻す。**
	--	合成でオブジェクトが上下に pady だけ大きくなる。縦の基準が
	--	上端なので、そのままだと文字が pady だけ下がり、
	--	背景を切った時と位置が変わってしまう。
	--	横は下の obj.w / 2 が文字の幅を使っているので影響を受けない
	obj.oy = obj.oy - pady
end

--	**箱を描くかどうかに関わらず位置は合わせる。**
--	不透明度 0 で背景を切っても、行の左端は揃っていて欲しい
if leftalign == 1 and w > 0 then
	obj.ox = obj.ox + w / 2
end

--	縦の基準。「左寄せ[上]」の [上] が上端基準なら何もしなくてよいが、
--	中央基準だった場合はここで半分ずらして上端に合わせる。
--	**実機で見比べて決める為の設定。**既定は「何もしない」
if topalign == 1 and h > 0 then
	obj.oy = obj.oy + h / 2
end

if dbg == 1 then
	print("TSMemory字幕背景: 合成後 obj=" .. obj.w .. "x" .. obj.h
		  .. " ox=" .. obj.ox .. " oy=" .. obj.oy)
end
